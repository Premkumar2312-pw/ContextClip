# ==============================================
# ContextClip Environment Configuration Template
# Copy this file to .env and fill in the values
# DO NOT commit .env with real credentials
# ==============================================

# PostgreSQL Configuration (Docker & Backend)
POSTGRES_DB=contextclip
POSTGRES_USER=contextclip_user
POSTGRES_PASSWORD=change_me_locally
DB_HOST=localhost
DB_PORT=5432

# Backend Service Configuration (Java Spring Boot)
SERVER_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60
AI_SERVICE_TIMEOUT_SECONDS=60

# AI Service Configuration (Python FastAPI - Google Gemini Interactions API)
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Frontend Configuration (React)
FRONTEND_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Desktop Agent Configuration
# DESKTOP_AGENT_API_URL — backend clipboard endpoint (default: http://localhost:8080/api/clipboard)
# DESKTOP_AGENT_AUTH_URL — backend auth login endpoint (default: http://localhost:8080/api/auth/login)
# AGENT_USERNAME / AGENT_PASSWORD — dedicated agent credentials (REQUIRED for secured backend)
#   The backend seeds this account automatically on startup when both vars are present.
#   Set AGENT_PASSWORD to a strong random value. NEVER commit the real value.
DESKTOP_AGENT_API_URL=http://localhost:8080/api/clipboard
DESKTOP_AGENT_AUTH_URL=http://localhost:8080/api/auth/login
AGENT_USERNAME=contextclip-agent
AGENT_PASSWORD=change_me_agent_password

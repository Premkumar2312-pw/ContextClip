# ==============================================
# ContextClip Environment Configuration Template
# Copy this file to .env and fill in the values
# DO NOT commit .env with real credentials
# ==============================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contextclip_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Backend Service Configuration (Java Spring Boot)
SERVER_PORT=8080
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# AI Service Configuration (Python FastAPI)
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_llm_model_name

# Frontend Configuration (React)
FRONTEND_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Desktop Agent Configuration
DESKTOP_AGENT_API_URL=http://localhost:8080/api/clipboard
